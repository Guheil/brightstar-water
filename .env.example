# Public Supabase browser configuration. Use the publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only credential used by existing protected API routes and recovery
# rate/session controls. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_server_only_supabase_secret

# Generate at least 32 random characters. It signs the short-lived, HttpOnly
# recovery intent and HMACs recovery rate-limit identities.
PASSWORD_RECOVERY_INTENT_SECRET=replace_with_a_unique_32_plus_character_secret
